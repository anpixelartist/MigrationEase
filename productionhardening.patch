-+export interface OidcConfig {
-+  issuer: string;
-+  clientId: string;
-+}
-+
-+export interface TokenSet {
-+  access_token: string;
-+  refresh_token?: string;
-+  id_token?: string;
-+  expires_in?: number;
-+}
