+            remaining = deadline - loop.time()
+            if remaining <= 0:
+                raise BridgeOffline("bridge did not respond in time")
+            message = await pubsub.get_message(
+                ignore_subscribe_messages=True, timeout=min(remaining, 1.0)
+            )
+            if message is None:
+                continue
