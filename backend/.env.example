# Copy to .env for a prod-like local run against infra/docker-compose.yml.
# Dev defaults (no .env) use SQLite + local-FS storage + in-process task broker.

# --- persistence (Postgres via psycopg) ---
# PROD: connect as the NON-OWNER app role so Row-Level Security applies (owners bypass RLS).
# The role is created by infra/postgres-init/01-app-role.sql; run Alembic as the owner ('tally').
TM_DATABASE_URL=postgresql+psycopg://tally_app:tally_app_change_me@localhost:5432/tallymigration
# Dev/migrations (owner role):
# TM_DATABASE_URL=postgresql+psycopg://tally:tally@localhost:5432/tallymigration

# --- task queue (Redis; enables real off-request-path workers) ---
# Redis also carries the cross-process bridge relay (worker -> API replica holding the WS).
TM_BROKER_URL=redis://localhost:6379
# run a worker:  conda run -n tally --cwd backend taskiq worker app.workers.broker:broker app.workers.tasks

# --- CORS (prod: set the real frontend origin; "*" disables credentialed CORS) ---
# TM_CORS_ORIGINS=["https://app.example.com"]

# --- observability ---
# TM_SENTRY_DSN=            # set to enable Sentry error tracking
TM_METRICS_ENABLED=true     # Prometheus metrics at /metrics

# --- object storage (MinIO / S3) ---
TM_STORAGE_BACKEND=s3
TM_S3_ENDPOINT=http://localhost:9100
TM_S3_BUCKET=tallymigration
TM_S3_REGION=us-east-1
TM_S3_ACCESS_KEY=minio
TM_S3_SECRET_KEY=minio12345

# --- auth ---
# Mode: legacy (built-in password auth, default) | hybrid (both, for migration) | keycloak (OIDC only).
TM_AUTH_MODE=legacy
# Legacy HS256 secret — required unless TM_AUTH_MODE=keycloak (CHANGE THIS; >=32 bytes).
TM_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Rate limit for /auth/login|signup, per client IP ("N/second|minute|hour"; empty = off).
TM_AUTH_RATE_LIMIT=20/minute
# Behind a TLS-terminating proxy/LB, enable so the rate limiter keys on the real client IP (from
# X-Forwarded-For) instead of the proxy. Set the number of trusted proxies between client and app.
# TM_TRUST_FORWARDED_FOR=true
# TM_FORWARDED_FOR_DEPTH=1

# --- Keycloak / OIDC (required when TM_AUTH_MODE=hybrid|keycloak) ---
# Issuer exactly as it appears in tokens (realm URL). Local dev (infra/docker-compose.yml):
TM_OIDC_ISSUER=http://localhost:8080/realms/tallymigration
# Audience the API requires in access tokens (set by the realm's audience mapper).
TM_OIDC_AUDIENCE=tallymigration-api
# Public SPA client for Authorization Code + PKCE (served to the frontend via /auth/config).
TM_OIDC_WEB_CLIENT_ID=tallymigration-web
# JWKS URL override; empty = derived from the issuer (Keycloak layout).
# TM_OIDC_JWKS_URL=
# First OIDC login: link existing local accounts by verified email (migration path).
TM_OIDC_LINK_BY_EMAIL=true
# JIT-provision unknown identities (user + personal workspace, like signup).
TM_OIDC_JIT_PROVISIONING=true
# PROD: require a verified email before JIT-provisioning a new identity (needs realm verifyEmail=true
# + SMTP). Keeps users.email trustworthy. Set false ONLY for dev/demo realms without email delivery.
TM_OIDC_REQUIRE_VERIFIED_EMAIL=true

# --- dev only: bypass the bridge and push straight to a local Tally gateway ---
# TM_DIRECT_TALLY_PUSH=true
# TM_TALLY_URL=http://127.0.0.1:9000
